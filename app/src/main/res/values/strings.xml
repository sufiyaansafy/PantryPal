<?xml version="1.0" encoding="utf-8"?>

<resources>
    <string name="app_name">PantryPal</string>

    <!-- Pantry list screen -->
    <string name="title_pantry">My Pantry</string>
    <string name="menu_suggestions">What can I cook?</string>
    <string name="menu_settings">Settings</string>
    <string name="add_item">Add item</string>
    <string name="empty_pantry">Your pantry is empty.\n\nTap “Add item” to put your first ingredient in.</string>
    <string name="delete_item_description">Delete this ingredient</string>

    <!-- Expiry wording -->
    <string name="no_expiry">No expiry date</string>
    <string name="expires_on">Best before %1$s</string>
    <string name="expired_on">Expired %1$s</string>
    <string name="expires_today">Expires today – use it!</string>
    <plurals name="expires_in_days">
        <item quantity="one">Expires tomorrow – use it soon</item>
        <item quantity="other">Expires in %d days</item>
    </plurals>
    <plurals name="expiring_banner">
        <item quantity="one">%d item needs using up soon. Tap to see what you can cook.</item>
        <item quantity="other">%d items need using up soon. Tap to see what you can cook.</item>
    </plurals>

    <!-- Delete confirmation -->
    <string name="delete_title">Delete ingredient?</string>
    <string name="delete_message">Remove %1$s from your pantry?</string>
    <string name="delete">Delete</string>
    <string name="cancel">Cancel</string>
    <string name="deleted">%1$s deleted</string>

    <!-- Add / Edit screen -->
    <string name="title_add">Add ingredient</string>
    <string name="title_edit">Edit ingredient</string>
    <string name="back">Back</string>
    <string name="hint_name">Ingredient name</string>
    <string name="helper_name">For example: Tomatoes, Mielie meal, Bread slices</string>
    <string name="hint_quantity">Quantity</string>
    <string name="helper_quantity">Dry food in g or kg, liquids in ml or L, whole items in pcs</string>
    <string name="hint_unit">Unit</string>
    <string name="expiry_heading">Expiry date (optional)</string>
    <string name="expiry_none">Not set</string>
    <string name="pick_date">Pick a date</string>
    <string name="clear_date">Clear</string>
    <string name="save">Save</string>
    <string name="saving">Saving…</string>
    <string name="saved">Saved</string>

    <!-- Validation messages -->
    <string name="error_name_required">Please enter an ingredient name</string>
    <string name="error_name_length">Use between 2 and 40 characters</string>
    <string name="error_name_letters">Letters only (spaces, hyphens and apostrophes are allowed)</string>
    <string name="error_quantity_required">Please enter a quantity</string>
    <string name="error_quantity_positive">Quantity must be a number greater than 0</string>
    <string name="error_quantity_too_big">That quantity is too large</string>
    <string name="error_unit">Choose a unit from the list</string>

    <!-- Suggested Recipes screen -->
    <plurals name="cook_now_summary">
        <item quantity="one">You can cook %d recipe right now, using only what is in your pantry.</item>
        <item quantity="other">You can cook %d recipes right now, using only what is in your pantry.</item>
    </plurals>
    <string name="empty_suggestions">No recipes match your pantry yet – add more ingredients.</string>
    <string name="almost_there_heading">Almost there</string>
    <string name="almost_there_note">Not suggested: each of these is missing exactly one ingredient.</string>
    <string name="recipe_info">%1$d min · %2$d ingredients</string>
    <string name="still_need">Still need: %1$s</string>
    <string name="uses_expiring">Uses food that expires soon – cook this first</string>

    <!-- Recipe Detail screen -->
    <string name="status_can_cook">You have everything you need – happy cooking!</string>
    <plurals name="status_missing">
        <item quantity="one">You are missing %d ingredient (marked ✗)</item>
        <item quantity="other">You are missing %d ingredients (marked ✗)</item>
    </plurals>
    <string name="ingredients_heading">Ingredients</string>
    <string name="method_heading">Method</string>

    <!-- The units the app allows (same list as the CHECK rule in the database) -->
    <string-array name="units">
        <item>g</item>
        <item>kg</item>
        <item>ml</item>
        <item>L</item>
        <item>tsp</item>
        <item>tbsp</item>
        <item>cup</item>
        <item>pcs</item>
    </string-array>
</resources>